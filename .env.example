# Copie para .env e ajuste depois de medir a VPS:
#   nproc
#   free -h
#   . /etc/os-release && echo "$PRETTY_NAME"
#
# Premissa deste exemplo, enquanto essa medição não entra no arquivo:
# Ubuntu 24.04 LTS e uma VPS compartilhada em que o Lastro não pode
# ocupar a máquina inteira. Os números abaixo deixam o motor de leitura
# com 1 CPU e 1536 MiB, e o stack inteiro com 2 CPUs e 2432 MiB.
#
# Num host de 4 vCPUs e 8 GiB isso fica perto de metade da CPU e de 30% da RAM.
# Num host de 2 vCPUs, troque para o perfil comentado no fim do arquivo.
# ./scripts/vps.sh preflight recusa a subida se a soma passar de 70% da RAM
# ou de 80% das vCPUs reais.

HOST_WEB_PORT=4181
HOST_API_PORT=8091

AI_CPU_LIMIT=1.0
AI_CPU_RESERVATION=0.25
AI_MEMORY_LIMIT=1536M
AI_MEMORY_RESERVATION=384M
AI_PIDS_LIMIT=128

BACKEND_CPU_LIMIT=0.50
BACKEND_CPU_RESERVATION=0.10
BACKEND_MEMORY_LIMIT=384M
BACKEND_MEMORY_RESERVATION=128M
BACKEND_PIDS_LIMIT=64

FRONTEND_CPU_LIMIT=0.50
FRONTEND_CPU_RESERVATION=0.10
FRONTEND_MEMORY_LIMIT=512M
FRONTEND_MEMORY_RESERVATION=128M
FRONTEND_PIDS_LIMIT=256

BACKUP_DIR=./backups
RETENTION_DAYS=14

# Diálogos do conselho. Sem chave, a crônica local mantém os três personagens.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Perfil para 2 vCPUs, quando a VPS já roda outras automações:
# AI_CPU_LIMIT=0.75
# BACKEND_CPU_LIMIT=0.25
# FRONTEND_CPU_LIMIT=0.25
# AI_MEMORY_LIMIT=1024M
# BACKEND_MEMORY_LIMIT=256M
# FRONTEND_MEMORY_LIMIT=384M
